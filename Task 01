#include <iostream>
#include <memory>
#include <stdexcept>
#include <string>
#include <vector>
#include <algorithm>

using namespace std;

class Bill {
protected:
    string patient;

public:
    explicit Bill(string p) : patient(p) {}
    virtual ~Bill() = default;

    virtual double total() const = 0;
    virtual string type() const = 0;

    void print() const {
        cout << type() << " | " << patient
             << " | " << total() << '\n';
    }
};

class OutPatientBill : public Bill {
    double consultation, tests;

public:
    OutPatientBill(string p, double c, double t)
        : Bill(p), consultation(c), tests(t) {
        if (c < 0 || t < 0)
            throw invalid_argument("negative charge");
    }

    double total() const override {
        return consultation + tests;
    }

    string type() const override {
        return "OP";
    }
};

class InPatientBill : public Bill {
    int days;
    double perDay, procedures, medicines;

public:
    InPatientBill(string p, int d, double rate,
                  double proc, double med)
        : Bill(p), days(d), perDay(rate),
          procedures(proc), medicines(med) {
        if (d < 0 || rate < 0 || proc < 0 || med < 0)
            throw invalid_argument("negative inpatient value");
    }

    double total() const override {
        return days * perDay + procedures + medicines;
    }

    string type() const override {
        return "IP";
    }
};

class DayCareBill : public Bill {
    double packagePrice;

public:
    DayCareBill(string p, double price)
        : Bill(p), packagePrice(price) {
        if (price < 0)
            throw invalid_argument("negative package price");
    }

    double total() const override {
        return packagePrice;
    }

    string type() const override {
        return "DayCare";
    }
};

class EmergencyBill : public Bill {
    double baseCharge, timeCharge;

public:
    EmergencyBill(string p, double base, double time)
        : Bill(p), baseCharge(base), timeCharge(time) {
        if (base < 0 || time < 0)
            throw invalid_argument("negative emergency charge");
    }

    double total() const override {
        return baseCharge + timeCharge;
    }

    string type() const override {
        return "Emergency";
    }
};

class Payer {
public:
    virtual ~Payer() = default;
    virtual string name() const = 0;
    virtual double amountCovered(const Bill& bill) const = 0;
};

class SelfPay : public Payer {
public:
    string name() const override {
        return "SelfPay";
    }

    double amountCovered(const Bill& bill) const override {
        return 0.0;
    }
};

class Insurance : public Payer {
    double coverLimit, coPayPercent;

public:
    Insurance(double limit, double copay)
        : coverLimit(limit), coPayPercent(copay) {
        if (limit < 0 || copay < 0 || copay > 100)
            throw invalid_argument("invalid insurance policy");
    }

    string name() const override {
        return "Insurance";
    }

    double amountCovered(const Bill& bill) const override {
        return min(bill.total(), coverLimit)
               * (1.0 - coPayPercent / 100.0);
    }
};

class GovernmentScheme : public Payer {
    double fixedPackageRate;

public:
    explicit GovernmentScheme(double rate)
        : fixedPackageRate(rate) {
        if (rate < 0)
            throw invalid_argument("invalid government package");
    }

    string name() const override {
        return "GovernmentScheme";
    }

    double amountCovered(const Bill& bill) const override {
        return min(bill.total(), fixedPackageRate);
    }
};

int main() {
    try {
        vector<unique_ptr<Bill>> bills;

        bills.push_back(make_unique<OutPatientBill>(
            "Ravi", 500, 1200));

        bills.push_back(make_unique<InPatientBill>(
            "Meena", 3, 2500, 40000, 3000));

        bills.push_back(make_unique<DayCareBill>(
            "Arun", 18000));

        bills.push_back(make_unique<EmergencyBill>(
            "Divya", 2500, 3500));

        SelfPay self;
        Insurance insurance(50000, 20);
        GovernmentScheme govt(20000);

        vector<const Payer*> payers{
            &self, &insurance, &govt
        };

        double dailyTotal = 0;

        cout << "BILL DETAILS\n";

        for (const auto& bill : bills) {
            bill->print();
            dailyTotal += bill->total();

            for (const Payer* payer : payers) {
                cout << "  " << payer->name()
                     << " covers: "
                     << payer->amountCovered(*bill) << '\n';
            }
        }

        cout << "Daily total: " << dailyTotal << '\n';

    } catch (const exception& e) {
        cerr << "Billing error: " << e.what() << '\n';
        return 1;
    }

    return 0;
}
