#include <iostream>
#include <memory>
#include <vector>
#include <string>
#include <algorithm>
using namespace std;

class Bill {
protected:
    string patient;

public:
    explicit Bill(string p) : patient(p) {}
    virtual ~Bill() = default;

    virtual double total() const = 0;
    virtual string type() const = 0;

    void print() const {
        cout << type() << " " << patient
             << ": " << total() << '\n';
    }
};

class OutPatientBill : public Bill {
    double consultation, tests;

public:
    OutPatientBill(string p, double c, double t)
        : Bill(p), consultation(c), tests(t) {}

    double total() const override {
        return consultation + tests;
    }

    string type() const override {
        return "OP";
    }
};

class InPatientBill : public Bill {
    int days;
    double rate, surgery;

public:
    InPatientBill(string p, int d, double r, double s)
        : Bill(p), days(d), rate(r), surgery(s) {}

    double total() const override {
        return days * rate + surgery;
    }

    string type() const override {
        return "IP";
    }
};

// New bill type
class TelemedicineBill : public Bill {
    double consultation, platformFee;

public:
    TelemedicineBill(string p, double c, double f)
        : Bill(p), consultation(c), platformFee(f) {}

    double total() const override {
        return consultation + platformFee;
    }

    string type() const override {
        return "Telemedicine";
    }
};

class Payer {
public:
    virtual ~Payer() = default;
    virtual string name() const = 0;
    virtual double amountCovered(const Bill& b) const = 0;
};

class SelfPay : public Payer {
public:
    string name() const override {
        return "SelfPay";
    }

    double amountCovered(const Bill& b) const override {
        return 0;
    }
};

class CorporatePayer : public Payer {
    double limit;
    double percentage;

public:
    CorporatePayer(double l, double p)
        : limit(l), percentage(p) {}

    string name() const override {
        return "CorporatePayer";
    }

    double amountCovered(const Bill& b) const override {
        return min(b.total(), limit) * percentage / 100.0;
    }
};

int main() {
    vector<unique_ptr<Bill>> bills;

    bills.push_back(
        make_unique<OutPatientBill>("Ravi", 500, 1200));

    bills.push_back(
        make_unique<InPatientBill>("Meena", 3, 2500, 40000));

    bills.push_back(
        make_unique<TelemedicineBill>("Arun", 1000, 200));

    SelfPay self;
    CorporatePayer corporate(50000, 80);

    vector<const Payer*> payers{&self, &corporate};

    cout << "HOSPITAL BILLING SYSTEM\n";

    for (const auto& bill : bills) {
        bill->print();

        for (const Payer* payer : payers) {
            cout << payer->name() << " covers: "
                 << payer->amountCovered(*bill) << '\n';
        }

        cout << '\n';
    }

    cout << "All bill types tested successfully.\n";
    cout << "New bill and payer added without changing existing classes.\n";

    return 0;
}
